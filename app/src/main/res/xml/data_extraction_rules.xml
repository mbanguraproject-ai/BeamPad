<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusions as backup_rules.xml, for cloud backup and
     for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="beampad_snippets.xml" />
        <exclude domain="sharedpref" path="beampad_devices.xml" />
        <exclude domain="sharedpref" path="beampad_panels.xml" />
        <exclude domain="sharedpref" path="beampad_macros.xml" />
        <exclude domain="sharedpref" path="beampad_log.xml" />
        <exclude domain="sharedpref" path="beampad_ads.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="beampad_snippets.xml" />
        <exclude domain="sharedpref" path="beampad_devices.xml" />
        <exclude domain="sharedpref" path="beampad_panels.xml" />
        <exclude domain="sharedpref" path="beampad_macros.xml" />
        <exclude domain="sharedpref" path="beampad_log.xml" />
        <exclude domain="sharedpref" path="beampad_ads.xml" />
    </device-transfer>
</data-extraction-rules>
