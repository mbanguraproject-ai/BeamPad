<?xml version="1.0" encoding="utf-8"?>
<!-- The one type scale. Medium weight for anything that names a thing,
     regular for anything that explains it. Slight negative tracking on
     large sizes keeps headings tight; captions get a little air. -->
<resources>
    <style name="Text" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/bpText</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Medium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- Hero numbers and the Pro headline. -->
    <style name="Text.Display" parent="Text.Medium">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Page titles: tabs and pushed screens. -->
    <style name="Text.Headline" parent="Text.Medium">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!-- Sheet titles and large card titles. -->
    <style name="Text.Title" parent="Text.Medium">
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Row titles, device names, card headings. -->
    <style name="Text.Subtitle" parent="Text.Medium">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Body.Dim">
        <item name="android:textColor">?attr/bpTextDim</item>
    </style>

    <style name="Text.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/bpTextDim</item>
    </style>

    <style name="Text.Small.Faint">
        <item name="android:textColor">?attr/bpTextFaint</item>
    </style>

    <!-- Buttons, chips and key captions. -->
    <style name="Text.Label" parent="Text.Medium">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Label.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/bpTextDim</item>
    </style>

    <!-- Section names above grouped cards. -->
    <style name="Text.Overline" parent="Text.Medium">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/bpTextFaint</item>
    </style>

    <!-- Labels printed on keys. -->
    <style name="Text.Key" parent="Text.Medium">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Key.Small">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Numeric">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="fontFamily">sans-serif-light</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Material's own appearance slots, mapped onto the scale so stock
         components (nav labels, buttons, sheets) match the rest. -->
    <style name="TextAppearance.BeamPad.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.BeamPad.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.BeamPad.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.BeamPad.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
