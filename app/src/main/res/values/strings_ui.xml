    <!-- Compatibility -->
    <string name="compat_full">Full</string>
    <string name="compat_most">Most</string>
    <string name="compat_keyboard_only">Keyboard</string>
    <string name="compat_varies">Varies</string>
    <string name="compat_none">No</string>
    <string name="compat_test_title">The quick test</string>
    <string name="compat_test_body">BeamPad works as a standard Bluetooth keyboard and mouse. If a device’s Bluetooth menu offers to add a keyboard, mouse, remote or accessory, BeamPad will work with it.</string>
    <string name="compat_group_tv">TVs and streaming</string>
    <string name="compat_googletv">Google TV and Android TV</string>
    <string name="compat_googletv_body">Sony, TCL, Hisense, Philips, Chromecast with Google TV, Nvidia Shield. Keyboard, pointer, remote and media keys.</string>
    <string name="compat_firetv">Amazon Fire TV</string>
    <string name="compat_firetv_body">Keyboard, navigation and media keys. The pointer works only in apps that support a mouse.</string>
    <string name="compat_samsung">Samsung TVs</string>
    <string name="compat_samsung_body">Keyboard and mouse through Input Device Manager on most models. Media keys vary by app.</string>
    <string name="compat_lg">LG TVs</string>
    <string name="compat_lg_body">Many models accept Bluetooth keyboards and mice; some only over USB. Use the quick test.</string>
    <string name="compat_appletv">Apple TV</string>
    <string name="compat_appletv_body">Typing and arrow keys. tvOS has no mouse pointer.</string>
    <string name="compat_roku">Roku</string>
    <string name="compat_roku_body">Roku devices don’t accept Bluetooth keyboards or mice.</string>
    <string name="compat_group_computers">Computers</string>
    <string name="compat_windows">Windows 10 and 11</string>
    <string name="compat_windows_body">Keyboard, trackpad, mouse, media and shortcuts.</string>
    <string name="compat_mac">Mac</string>
    <string name="compat_mac_body">Everything works. If the keyboard assistant opens, close it and choose ANSI.</string>
    <string name="compat_chromeos">Chromebook</string>
    <string name="compat_chromeos_body">Keyboard, trackpad, mouse and media keys.</string>
    <string name="compat_linux">Linux</string>
    <string name="compat_linux_body">Works with standard desktop Bluetooth (GNOME, KDE and others).</string>
    <string name="compat_group_other">Other devices</string>
    <string name="compat_projector">Projectors</string>
    <string name="compat_projector_body">Android-based projectors work like Android TV. Others: use the quick test.</string>
    <string name="compat_tablet">Android tablets and phones</string>
    <string name="compat_tablet_body">Keyboard, pointer and media keys.</string>
    <string name="compat_ipad">iPad</string>
    <string name="compat_ipad_body">Keyboard and pointer. Some media keys depend on the app.</string>
    <string name="compat_group_tips">Good to know</string>
    <string name="compat_tip_layout">Match the keyboard layout</string>
    <string name="compat_tip_layout_body">Bluetooth sends key positions, not letters. If symbols arrive wrong, set the layout your device uses, in Settings or on the device’s own page.</string>
    <string name="compat_tip_phone">This phone must support keyboard mode</string>
    <string name="compat_tip_phone_body">Most Android 9 and newer phones can act as a Bluetooth keyboard; a few makers remove it. Diagnostics shows whether this one can.</string>

