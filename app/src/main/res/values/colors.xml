<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palettes for the three appearances. A deep neutral ladder (bg ->
         surface -> raised -> high) carries all depth; one restrained indigo
         accent marks primary actions and selection; mint marks live states
         (connected, on). Keys press to a lighter neutral, never to colour. -->

    <!-- dark -->
    <color name="dark_bg">#0B0C10</color>
    <color name="dark_surface">#14161C</color>
    <color name="dark_surface_raised">#1C1F27</color>
    <color name="dark_surface_high">#272B35</color>
    <color name="dark_stroke">#22252E</color>
    <color name="dark_stroke_strong">#353A47</color>
    <color name="dark_accent">#6366F1</color>
    <color name="dark_accent_2">#A9ABFB</color>
    <color name="dark_accent_soft">#2B6366F1</color>
    <color name="dark_on_accent">#FFFFFF</color>
    <color name="dark_live">#3DD9B0</color>
    <color name="dark_live_soft">#223DD9B0</color>
    <color name="dark_text">#F3F4F7</color>
    <color name="dark_text_dim">#A2A7B5</color>
    <color name="dark_text_faint">#6B7081</color>
    <color name="dark_key">#1C1F27</color>
    <color name="dark_key_pressed">#2C303B</color>
    <color name="dark_key_stroke">#2A2E38</color>
    <color name="dark_scrim">#E60B0C10</color>
    <color name="dark_danger">#F87171</color>

    <!-- black -->
    <color name="black_bg">#000000</color>
    <color name="black_surface">#0C0D11</color>
    <color name="black_surface_raised">#14161B</color>
