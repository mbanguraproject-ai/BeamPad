    <color name="black_accent">#6366F1</color>
    <color name="black_accent_2">#A9ABFB</color>
    <color name="black_accent_soft">#2E6366F1</color>
    <color name="black_on_accent">#FFFFFF</color>
    <color name="black_live">#3DD9B0</color>
    <color name="black_live_soft">#243DD9B0</color>
    <color name="black_text">#F3F4F7</color>
    <color name="black_text_dim">#9DA2B1</color>
