        <item name="colorSecondary">@color/dark_accent_2</item>
        <item name="colorSecondaryContainer">@color/dark_surface_high</item>
        <item name="colorOnSecondaryContainer">@color/dark_text</item>
        <item name="colorError">@color/dark_danger</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/dark_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_dim</item>
        <item name="colorSurfaceContainerLowest">@color/dark_bg</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface</item>
        <item name="colorSurfaceContainer">@color/dark_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/dark_surface_high</item>
        <item name="colorOutline">@color/dark_stroke_strong</item>
        <item name="colorOutlineVariant">@color/dark_stroke</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_dim</item>
        <item name="android:textColorHint">@color/dark_text_faint</item>
        <item name="bpBg">@color/dark_bg</item>
        <item name="bpSurface">@color/dark_surface</item>
        <item name="bpSurfaceRaised">@color/dark_surface_raised</item>
        <item name="bpSurfaceHigh">@color/dark_surface_high</item>
        <item name="bpStroke">@color/dark_stroke</item>
        <item name="bpStrokeStrong">@color/dark_stroke_strong</item>
        <item name="bpAccent">@color/dark_accent</item>
        <item name="bpAccent2">@color/dark_accent_2</item>
