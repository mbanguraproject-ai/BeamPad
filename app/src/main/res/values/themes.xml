<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme. The window shows this until MainActivity draws, so
         without it the system shows a blank frame. -->
    <style name="Theme.BeamPad.Splash" parent="Theme.SplashScreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.BeamPad</item>
    </style>

    <!-- Fixed dark identity. Dynamic colour is deliberately not used: the
         brand should not change with the user's wallpaper. -->
    <style name="Theme.BeamPad" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/bp_accent</item>
        <item name="colorOnPrimary">@color/bp_text</item>
        <item name="colorSurface">@color/bp_surface</item>
        <item name="colorOnSurface">@color/bp_text</item>
        <item name="colorSurfaceVariant">@color/bp_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/bp_text_dim</item>
        <item name="colorOutline">@color/bp_stroke</item>
        <item name="android:colorBackground">@color/bp_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/bp_bg</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BeamPad.BottomSheet</item>
    </style>

    <!-- Sheets: the app's surface colour with large top corners, instead of
         Material's default tinted grey. -->
    <style name="ThemeOverlay.BeamPad.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BeamPad.BottomSheet</item>
    </style>

    <style name="Widget.BeamPad.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/bp_surface</item>
        <item name="shapeAppearance">@style/Shape.Sheet</item>
    </style>

    <style name="Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Buttons. Backgrounds are drawables so gradients and ripples work;
         backgroundTint is cleared or Material would flatten them. -->
    <style name="Widget.BeamPad.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.BeamPad.PrimaryButton" parent="Widget.BeamPad.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/bp_text</item>
        <item name="iconTint">@color/bp_text</item>
    </style>

    <style name="Widget.BeamPad.SecondaryButton" parent="Widget.BeamPad.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/bp_text</item>
        <item name="iconTint">@color/bp_text</item>
    </style>

    <style name="Widget.BeamPad.ProButton" parent="Widget.BeamPad.Button">
        <item name="android:background">@drawable/bg_pro_button</item>
        <item name="android:textColor">@color/bp_on_pro</item>
        <item name="iconTint">@color/bp_on_pro</item>
    </style>

    <style name="Widget.BeamPad.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/bp_accent_2</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.BeamPad.LinkButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bp_text_dim</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.BeamPad.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/switch_track_stroke</item>
    </style>

    <style name="Widget.BeamPad.Slider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">58dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="labelBehavior">gone</item>
        <item name="thumbColor">@color/bp_text</item>
        <item name="trackColorActive">@color/bp_accent_2</item>
        <item name="trackColorInactive">@color/bp_surface_high</item>
        <item name="haloColor">#337C6BFF</item>
        <item name="tickVisible">false</item>
    </style>

    <!-- Tool chips under the keyboard field: an even third of the row each. -->
    <style name="ToolChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ToolChipBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_tool_chip</item>
    </style>

    <style name="ToolChipIcon">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:tint">@color/bp_text</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="ToolChipText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bp_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ToolChipLock">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_lock_badge</item>
    </style>

    <style name="ToolChipLockIcon">
        <item name="android:layout_width">9dp</item>
        <item name="android:layout_height">9dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:src">@drawable/ic_lock_simple_fill</item>
        <item name="android:tint">@color/bp_on_pro</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <!-- Settings rows sit in grouped cards, each with a leading icon tile. -->
    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="SettingsIconTile">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_icon_square</item>
    </style>

    <style name="SettingsIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/bp_accent_2</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="SettingsChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_caret_right</item>
        <item name="android:tint">@color/bp_text_faint</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="ProTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/bg_pro_badge</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:text">@string/pro_badge</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/bp_on_pro</item>
    </style>
    <style name="Shape.Fab.Squircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Nav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bp_accent</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>
    <style name="Theme.BeamPad.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bp_surface</item>
        <item name="colorOnSurface">@color/bp_text</item>
        <item name="colorPrimary">@color/bp_accent_2</item>
        <item name="colorOnSurfaceVariant">@color/bp_text_dim</item>
        <item name="colorOutline">@color/bp_stroke</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Dialog</item>
    </style>

    <style name="Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/bp_text_dim</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/bp_text</item>
    </style>

    <style name="RowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">@color/bp_text_dim</item>
    </style>
    <style name="DpadKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/bp_text</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="WideKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/bp_text_dim</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/bp_text</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="RockerKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/bp_text</item>
        <item name="iconSize">22dp</item>
    </style>
    <style name="StackedKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/bp_text_dim</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/bp_text</item>
        <item name="iconSize">19dp</item>
    </style>
    <style name="IconKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/bp_text</item>
        <item name="iconSize">21dp</item>
    </style>
    <style name="TextKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/bp_text</item>
    </style>
</resources>
