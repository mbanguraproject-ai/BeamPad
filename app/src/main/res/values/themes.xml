<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme. The window shows this until MainActivity draws, so
         without it the system shows a blank frame. -->
    <style name="Theme.BeamPad.Splash" parent="Theme.SplashScreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.BeamPad</item>
    </style>

    <!-- Three appearances: Dark (default), Pure Black for OLED, and Light.
         Activities pick one through Appearance before inflating. Dynamic
         colour is deliberately not used: the brand should not change with
         the user's wallpaper. -->
    <style name="Theme.BeamPad" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorOnPrimary">@color/dark_on_accent</item>
        <item name="colorSecondary">@color/dark_accent_2</item>
        <item name="colorError">@color/dark_danger</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/dark_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_dim</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface</item>
        <item name="colorSurfaceContainer">@color/dark_surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_high</item>
        <item name="colorOutline">@color/dark_stroke_strong</item>
        <item name="colorOutlineVariant">@color/dark_stroke</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BeamPad.BottomSheet</item>
        <item name="bpBg">@color/dark_bg</item>
        <item name="bpSurface">@color/dark_surface</item>
        <item name="bpSurfaceRaised">@color/dark_surface_raised</item>
        <item name="bpSurfaceHigh">@color/dark_surface_high</item>
        <item name="bpStroke">@color/dark_stroke</item>
        <item name="bpStrokeStrong">@color/dark_stroke_strong</item>
        <item name="bpAccent">@color/dark_accent</item>
        <item name="bpAccent2">@color/dark_accent_2</item>
        <item name="bpAccentSoft">@color/dark_accent_soft</item>
        <item name="bpOnAccent">@color/dark_on_accent</item>
        <item name="bpLive">@color/dark_live</item>
        <item name="bpLiveSoft">@color/dark_live_soft</item>
        <item name="bpText">@color/dark_text</item>
        <item name="bpTextDim">@color/dark_text_dim</item>
        <item name="bpTextFaint">@color/dark_text_faint</item>
        <item name="bpKey">@color/dark_key</item>
        <item name="bpKeyPressed">@color/dark_key_pressed</item>
        <item name="bpKeyStroke">@color/dark_key_stroke</item>
        <item name="bpScrim">@color/dark_scrim</item>
        <item name="bpDanger">@color/dark_danger</item>
    </style>

    <style name="Theme.BeamPad.Black" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/black_accent</item>
        <item name="colorOnPrimary">@color/black_on_accent</item>
        <item name="colorSecondary">@color/black_accent_2</item>
        <item name="colorError">@color/black_danger</item>
        <item name="colorSurface">@color/black_surface</item>
        <item name="colorOnSurface">@color/black_text</item>
        <item name="colorSurfaceVariant">@color/black_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/black_text_dim</item>
        <item name="colorSurfaceContainerLow">@color/black_surface</item>
        <item name="colorSurfaceContainer">@color/black_surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/black_surface_high</item>
        <item name="colorOutline">@color/black_stroke_strong</item>
        <item name="colorOutlineVariant">@color/black_stroke</item>
        <item name="android:colorBackground">@color/black_bg</item>
        <item name="android:windowBackground">@color/black_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BeamPad.BottomSheet</item>
        <item name="bpBg">@color/black_bg</item>
        <item name="bpSurface">@color/black_surface</item>
        <item name="bpSurfaceRaised">@color/black_surface_raised</item>
        <item name="bpSurfaceHigh">@color/black_surface_high</item>
        <item name="bpStroke">@color/black_stroke</item>
        <item name="bpStrokeStrong">@color/black_stroke_strong</item>
        <item name="bpAccent">@color/black_accent</item>
        <item name="bpAccent2">@color/black_accent_2</item>
        <item name="bpAccentSoft">@color/black_accent_soft</item>
        <item name="bpOnAccent">@color/black_on_accent</item>
        <item name="bpLive">@color/black_live</item>
        <item name="bpLiveSoft">@color/black_live_soft</item>
        <item name="bpText">@color/black_text</item>
        <item name="bpTextDim">@color/black_text_dim</item>
        <item name="bpTextFaint">@color/black_text_faint</item>
        <item name="bpKey">@color/black_key</item>
        <item name="bpKeyPressed">@color/black_key_pressed</item>
        <item name="bpKeyStroke">@color/black_key_stroke</item>
        <item name="bpScrim">@color/black_scrim</item>
        <item name="bpDanger">@color/black_danger</item>
    </style>

    <style name="Theme.BeamPad.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/light_accent</item>
        <item name="colorOnPrimary">@color/light_on_accent</item>
        <item name="colorSecondary">@color/light_accent_2</item>
        <item name="colorError">@color/light_danger</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorSurfaceVariant">@color/light_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/light_text_dim</item>
        <item name="colorSurfaceContainerLow">@color/light_surface</item>
        <item name="colorSurfaceContainer">@color/light_surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/light_surface_high</item>
        <item name="colorOutline">@color/light_stroke_strong</item>
        <item name="colorOutlineVariant">@color/light_stroke</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.BeamPad.BottomSheet</item>
        <item name="bpBg">@color/light_bg</item>
        <item name="bpSurface">@color/light_surface</item>
        <item name="bpSurfaceRaised">@color/light_surface_raised</item>
        <item name="bpSurfaceHigh">@color/light_surface_high</item>
        <item name="bpStroke">@color/light_stroke</item>
        <item name="bpStrokeStrong">@color/light_stroke_strong</item>
        <item name="bpAccent">@color/light_accent</item>
        <item name="bpAccent2">@color/light_accent_2</item>
        <item name="bpAccentSoft">@color/light_accent_soft</item>
        <item name="bpOnAccent">@color/light_on_accent</item>
        <item name="bpLive">@color/light_live</item>
        <item name="bpLiveSoft">@color/light_live_soft</item>
        <item name="bpText">@color/light_text</item>
        <item name="bpTextDim">@color/light_text_dim</item>
        <item name="bpTextFaint">@color/light_text_faint</item>
        <item name="bpKey">@color/light_key</item>
        <item name="bpKeyPressed">@color/light_key_pressed</item>
        <item name="bpKeyStroke">@color/light_key_stroke</item>
        <item name="bpScrim">@color/light_scrim</item>
        <item name="bpDanger">@color/light_danger</item>
    </style>

    <!-- High contrast, layered over any appearance: secondary text at full
         strength and strokes at the strong weight, so edges and labels never
         rely on subtle greys. -->
    <style name="ThemeOverlay.BeamPad.HighContrast" parent="">
        <item name="bpTextDim">?attr/bpText</item>
        <item name="bpTextFaint">?attr/bpTextDim</item>
        <item name="bpStroke">?attr/bpStrokeStrong</item>
        <item name="bpKeyStroke">?attr/bpStrokeStrong</item>
    </style>

    <!-- Sheets: the app's surface colour with large top corners, instead of
         Material's default tinted grey. -->
    <style name="ThemeOverlay.BeamPad.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BeamPad.BottomSheet</item>
    </style>

    <style name="Widget.BeamPad.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/bpSurface</item>
        <item name="shapeAppearance">@style/Shape.Sheet</item>
    </style>

    <style name="Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Buttons. Backgrounds are drawables so gradients and ripples work;
         backgroundTint is cleared or Material would flatten them. -->
    <style name="Widget.BeamPad.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.BeamPad.PrimaryButton" parent="Widget.BeamPad.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">?attr/bpText</item>
        <item name="iconTint">?attr/bpText</item>
    </style>

    <style name="Widget.BeamPad.SecondaryButton" parent="Widget.BeamPad.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">?attr/bpText</item>
        <item name="iconTint">?attr/bpText</item>
    </style>

    <style name="Widget.BeamPad.ProButton" parent="Widget.BeamPad.Button">
        <item name="android:background">@drawable/bg_pro_button</item>
        <item name="android:textColor">@color/bp_on_pro</item>
        <item name="iconTint">@color/bp_on_pro</item>
    </style>

    <style name="Widget.BeamPad.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/bpAccent2</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.BeamPad.LinkButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/bpTextDim</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.BeamPad.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/switch_track_stroke</item>
    </style>

    <style name="Widget.BeamPad.Slider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">58dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="labelBehavior">gone</item>
        <item name="thumbColor">?attr/bpText</item>
        <item name="trackColorActive">?attr/bpAccent2</item>
        <item name="trackColorInactive">?attr/bpSurfaceHigh</item>
        <item name="haloColor">#337C6BFF</item>
        <item name="tickVisible">false</item>
    </style>

    <!-- Tool chips under the keyboard field: an even third of the row each. -->
    <style name="ToolChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ToolChipBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_tool_chip</item>
    </style>

    <style name="ToolChipIcon">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:tint">?attr/bpText</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="ToolChipText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bpText</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ToolChipLock">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_lock_badge</item>
    </style>

    <style name="ToolChipLockIcon">
        <item name="android:layout_width">9dp</item>
        <item name="android:layout_height">9dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:src">@drawable/ic_lock_simple_fill</item>
        <item name="android:tint">@color/bp_on_pro</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <!-- Settings rows sit in grouped cards, each with a leading icon tile. -->
    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="SettingsIconTile">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_icon_square</item>
    </style>

    <style name="SettingsIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">?attr/bpAccent2</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="SettingsChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_caret_right</item>
        <item name="android:tint">?attr/bpTextFaint</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="ProTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/bg_pro_badge</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:text">@string/pro_badge</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/bp_on_pro</item>
    </style>
    <style name="Shape.Fab.Squircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Nav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/bpAccentSoft</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>
    <style name="Theme.BeamPad.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/bpSurface</item>
        <item name="colorOnSurface">?attr/bpText</item>
        <item name="colorPrimary">?attr/bpAccent2</item>
        <item name="colorOnSurfaceVariant">?attr/bpTextDim</item>
        <item name="colorOutline">?attr/bpStroke</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Dialog</item>
    </style>

    <style name="Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/bpTextDim</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/bpText</item>
    </style>

    <style name="RowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/bpTextDim</item>
    </style>
    <style name="DpadKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/bpText</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="WideKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">?attr/bpTextDim</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/bpText</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="RockerKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_rocker_key</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/bpText</item>
        <item name="iconSize">22dp</item>
    </style>
    <style name="StackedKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
