<?xml version="1.0" encoding="utf-8"?>
<!-- The one spacing and shape scale. Screens use these names, never raw
     numbers, so every surface lines up with every other. -->
<resources>
    <!-- Spacing -->
    <dimen name="space_2xs">4dp</dimen>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">20dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_2xl">32dp</dimen>

    <!-- Screen edge and the gap between grouped controls. -->
    <dimen name="gutter">16dp</dimen>
    <dimen name="gap">10dp</dimen>

    <!-- Corners: tags, tiles, keys and fields, cards and pads, sheets. -->
    <dimen name="radius_xs">8dp</dimen>
    <dimen name="radius_sm">12dp</dimen>
    <dimen name="radius_md">16dp</dimen>
    <dimen name="radius_lg">24dp</dimen>
    <dimen name="radius_sheet">28dp</dimen>

    <!-- Heights -->
    <dimen name="top_bar_height">64dp</dimen>
    <dimen name="button_height">52dp</dimen>
    <dimen name="button_height_small">40dp</dimen>
    <dimen name="field_height">52dp</dimen>
    <dimen name="row_min_height">60dp</dimen>
    <dimen name="chip_height">40dp</dimen>
    <dimen name="key_height">56dp</dimen>
    <dimen name="icon_button">44dp</dimen>
    <dimen name="icon_tile">40dp</dimen>
    <dimen name="icon_tile_small">34dp</dimen>
    <dimen name="icon">22dp</dimen>
    <dimen name="icon_small">18dp</dimen>
    <dimen name="hairline">1dp</dimen>
</resources>
