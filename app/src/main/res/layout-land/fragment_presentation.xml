<?xml version="1.0" encoding="utf-8"?>
<!-- Presentation, landscape (the blueprint's landscape-first layout): slide
     buttons under the left thumb, timer, show controls and pointer under
     the right, for comfortable two-handed use standing at a display. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prev"
                style="@style/Key"
                android:layout_height="match_parent"
                android:text="@string/act_slide_prev"
                android:textAppearance="@style/Text.Label"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="30dp"
                app:icon="@drawable/ic_caret_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/next"
                style="@style/Key.Accent"
                android:layout_height="match_parent"
                android:layout_weight="1.7"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/act_slide_next"
                android:textAppearance="@style/Text.Label"
                android:textColor="?attr/bpOnAccent"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="36dp"
                app:icon="@drawable/ic_caret_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/gap"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/timerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_sm"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/present_timer"
                    android:textAppearance="@style/Text.Overline" />

                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/present_timer_zero"
                    android:textAppearance="@style/Text.Numeric"
                    android:textSize="38sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/timerReset"
                style="@style/Widget.BeamPad.IconButton"
                android:src="@drawable/ic_arrow_counter_clockwise"
                android:contentDescription="@string/present_timer_reset" />

            <ImageButton
                android:id="@+id/timerToggle"
                style="@style/Widget.BeamPad.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/space_xs"
                android:padding="14dp"
                android:background="@drawable/bg_send_round"
                android:tint="?attr/bpOnAccent"
                android:src="@drawable/ic_play_fill"
                android:contentDescription="@string/present_timer_start" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:text="@string/present_start"
                app:icon="@drawable/ic_play" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/black"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/present_black"
                app:icon="@drawable/ic_moon" />

            <com.google.android.material.button.MaterialButton

                android:id="@+id/laser"

                style="@style/Key.Stacked"

                android:layout_height="64dp"

                android:layout_marginStart="@dimen/gap"

                android:text="@string/present_laser"

                android:contentDescription="@string/present_laser_description"

                app:icon="@drawable/ic_hand_pointing" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/end"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/present_end"
                app:icon="@drawable/ic_x" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/gap">

            <com.devbangs.beampad.TrackpadView
                android:id="@+id/pointer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_trackpad"
                android:contentDescription="@string/present_pointer" />

            <View
                android:id="@+id/pointerGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_trackpad_active"
                android:alpha="0"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="8dp"
                android:text="@string/present_pointer_hint"
                android:textAppearance="@style/Text.Small.Faint"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

    </LinearLayout>
</LinearLayout>
