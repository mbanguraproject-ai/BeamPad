<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a card: optional icon tile, title and subtitle, and a
     trailing slot (switch, value, chevron, button). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_row">

    <FrameLayout
        android:id="@+id/iconTile"
        android:layout_width="@dimen/icon_tile_small"
        android:layout_height="@dimen/icon_tile_small"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:layout_gravity="center"
            android:tint="?attr/bpText"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Body" />

            <TextView
                android:id="@+id/badge"
                style="@style/ProTag"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Text.Small"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs" />
</LinearLayout>
