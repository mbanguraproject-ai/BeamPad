<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

<LinearLayout
    android:id="@+id/contentColumn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header: name and plan on the left, the upgrade and settings on the
         right. Nothing here changes width with connection state, so the
         header never reflows when a TV connects. -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:textColor="?attr/bpText" />

                <TextView
                    android:id="@+id/proBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pro_badge"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/pro_badge"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/bp_on_pro"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/planLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/plan_free_label"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/bpTextDim" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getPro"
            style="@style/Widget.BeamPad.ProButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/get_pro"
            android:textSize="14sp"
            app:icon="@drawable/ic_crown_simple_fill"
            app:iconSize="18dp"
            app:iconPadding="6dp" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear"
            android:background="@drawable/bg_icon_button"
            android:tint="?attr/bpText"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <!-- One card for every connection state. Disconnected it explains the
         next step and offers one button for it; connected it shrinks to a
         single row with the TV's name, returning space to the controls. -->
    <FrameLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card">

        <LinearLayout
            android:id="@+id/setupRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_chip">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_television_simple"
                    android:tint="?attr/bpText"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/status_ready"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/bpText" />

                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/bpTextDim" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/statusProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="24dp"
                app:trackThickness="3dp"
                app:indicatorColor="?attr/bpAccent2"
                app:trackColor="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusAction"
                style="@style/Widget.BeamPad.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:minWidth="96dp"
                android:layout_marginStart="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/action_connect" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/connectedRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_row"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_chip_mint">

                <ImageView
                    android:id="@+id/connectedIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_television_simple"
                    android:tint="?attr/bpLive"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_online" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_connected"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/bpLive" />
                </LinearLayout>

                <TextView
                    android:id="@+id/connectedName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/bpText" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnect"
                style="@style/Widget.BeamPad.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_disconnect"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Banner sits here, not above the nav: the trackpad is a drag surface
         and a banner below it would collect accidental clicks, which AdMob
         treats as invalid traffic. Collapsed to zero height until an ad
         actually loads, so there is no empty gap. -->
    <!-- AdMob forbids altering the ad itself, so only the container is
         styled: side margins and a rounded clip so the creative does not
         run edge to edge against the dark surface. -->
    <FrameLayout
        android:id="@+id/adSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_ad_slot"
        android:clipToOutline="true" />

    <!-- Wide windows (tablets, unfolded foldables, phones in landscape) swap
         the bottom bar for a rail beside the content, so the controls get the
         height back. Only one of the two is ever visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/navRail"
            android:layout_width="wrap_content"
            android:saveEnabled="false"
            android:layout_height="match_parent"
            android:background="?attr/bpBg"
            android:visibility="gone"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:menuGravity="center"
            app:itemActiveIndicatorStyle="@style/Nav.ActiveIndicator"
            app:itemTextColor="@color/nav_item"
            app:itemIconTint="@color/nav_item"
            app:menu="@menu/bottom_nav" />

        <FrameLayout
            android:id="@+id/tabContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:saveEnabled="false"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@style/Nav.ActiveIndicator"
        app:itemTextColor="@color/nav_item"
        app:itemIconTint="@color/nav_item"
        app:menu="@menu/bottom_nav" />

</LinearLayout>

</FrameLayout>
