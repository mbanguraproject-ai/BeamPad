<?xml version="1.0" encoding="utf-8"?>
<!-- A pushed screen: the shared header with Back, then scrolling content
     built from the Ui components. Settings, device details, diagnostics,
     compatibility, macros and editors all use it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app">

    <include
        android:id="@+id/header"
        layout="@layout/ui_page_header" />

    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_2xl"
            android:overScrollMode="never">

            <com.devbangs.beampad.ReadableColumn
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_horizontal" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.devbangs.beampad.ReadableColumn
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone" />
</LinearLayout>
