<?xml version="1.0" encoding="utf-8"?>
<!-- A typing field inside a panel, with its send key. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_input"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">

    <EditText
        android:id="@+id/input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:inputType="text"
        android:maxLines="1"
        android:textAppearance="@style/Text.Body"
        android:textColorHint="?attr/bpTextFaint"
        android:importantForAutofill="no" />

    <ImageButton
        android:id="@+id/send"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_send_round"
        android:tint="?attr/bpOnAccent"
        android:src="@drawable/ic_paper_plane_right"
        android:contentDescription="@string/keyboard_send" />
</LinearLayout>
