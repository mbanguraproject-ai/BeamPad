<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app">

    <include
        android:id="@+id/bar"
        layout="@layout/view_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/proCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pro_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_pro_icon">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_crown_simple_fill"
                    android:tint="@color/bp_on_pro"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/proTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_pro_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/bpText" />

                <TextView
                    android:id="@+id/proBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_pro_body"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/bpTextDim" />
            </LinearLayout>

            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_connection" />
        <LinearLayout
            style="@style/SettingsGroup">

        <LinearLayout
            android:id="@+id/rowReconnect"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_link_simple" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_reconnect" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_reconnect_hint" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReconnect"
                style="@style/Widget.BeamPad.Switch" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowScreenOn"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_sun" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_screen_on" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_screen_on_hint" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchScreenOn"
                style="@style/Widget.BeamPad.Switch" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowForget"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_x" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_forget" />
                <TextView
                    style="@style/RowSubtitle"
                    android:id="@+id/forgetValue" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_typing" />
        <LinearLayout
            style="@style/SettingsGroup">

        <LinearLayout
            android:id="@+id/rowLayout"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_globe" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_layout" />
                <TextView
                    style="@style/RowSubtitle"
                    android:id="@+id/layoutValue" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowProbe"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_text_aa" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_probe" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_probe_hint" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowLive"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_lightning" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_live" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_live_hint" />
            </LinearLayout>
            <TextView
                android:id="@+id/lockLive"
                style="@style/ProTag" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchLive"
                style="@style/Widget.BeamPad.Switch" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowHaptics"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_vibrate" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_haptics" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_haptics_hint" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchHaptics"
                style="@style/Widget.BeamPad.Switch" />
        </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_trackpad" />
        <LinearLayout
            android:id="@+id/trackpadGroup"
            style="@style/SettingsGroup">

        <LinearLayout
            android:id="@+id/rowPointer"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_mouse_simple" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_pointer_speed" />
                <TextView
                    style="@style/RowSubtitle"
                    android:id="@+id/pointerValue" />
            </LinearLayout>
            <TextView
                android:id="@+id/lockTrackpad"
                style="@style/ProTag" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPointer"
            style="@style/Widget.BeamPad.Slider"
            android:valueFrom="0.8"
            android:valueTo="3.2"
            android:stepSize="0.2" />
        <LinearLayout
            android:id="@+id/rowScroll"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_arrows_down_up" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_scroll_speed" />
                <TextView
                    style="@style/RowSubtitle"
                    android:id="@+id/scrollValue" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderScroll"
            style="@style/Widget.BeamPad.Slider"
            android:valueFrom="0.5"
            android:valueTo="2.5"
            android:stepSize="0.25" />
        <LinearLayout
            android:id="@+id/rowReverse"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_arrows_down_up" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_reverse_scroll" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_reverse_scroll_hint" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReverse"
                style="@style/Widget.BeamPad.Switch" />
        </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_purchases" />
        <LinearLayout
            style="@style/SettingsGroup">

        <LinearLayout
            android:id="@+id/rowRestore"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_arrow_clockwise" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/restore_purchases" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_restore_hint" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowPrivacyOptions"
            style="@style/SettingsRow"
            android:visibility="gone">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_shield_check" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/privacy_options" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        </LinearLayout>
        <TextView
            style="@style/SectionHeader"
            android:text="@string/settings_about" />
        <LinearLayout
            style="@style/SettingsGroup">

        <LinearLayout
            android:id="@+id/rowRate"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_star" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/settings_rate" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/settings_rate_hint" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowPrivacy"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_shield_check" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/privacy_title" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowTerms"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_file_text" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/terms_title" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowLicences"
            style="@style/SettingsRow">
            <FrameLayout style="@style/SettingsIconTile">
                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_code" />
            </FrameLayout>
            <LinearLayout style="@style/SettingsRowText">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/licences_title" />
            </LinearLayout>
            <ImageView style="@style/SettingsChevron" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/bpTextFaint" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
