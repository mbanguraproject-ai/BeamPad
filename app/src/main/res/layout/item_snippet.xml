<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bp_surface"
    app:strokeColor="@color/bp_stroke"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_square">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_key"
                android:tint="@color/bp_accent_2"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold"
            android:textColor="@color/bp_text" />

        <ImageButton
            android:id="@+id/delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trash"
            android:tint="@color/bp_text_faint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/snippet_delete" />

        <ImageButton
            android:id="@+id/send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_paper_plane_right"
            android:tint="@color/bp_text"
            android:background="@drawable/bg_send_round"
            android:contentDescription="@string/snippet_send" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
