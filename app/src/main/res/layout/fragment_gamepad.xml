<?xml version="1.0" encoding="utf-8"?>
<!-- Gamepad: shoulder buttons and Select, Home and Start along the top,
     then the left stick, the D-pad, A B X Y and the right stick. Every
     button holds while pressed, and several can be held at once. Until
     gamepad support is turned on, the setup card shows instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/pad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padL2"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:text="L2" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padL1"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap"
            android:text="L1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padSelect"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap"
            android:text="@string/pad_select" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padHome"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap"
            android:text="@string/pad_home" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padStart"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap"
            android:text="@string/pad_start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padR1"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap"
            android:text="R1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/padR2"
            style="@style/Key.Small"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap"
            android:text="R2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/gap"
            android:orientation="horizontal">

            <com.devbangs.beampad.JoystickView
                android:id="@+id/leftStick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/pad_left_stick" />

        <LinearLayout
            android:id="@+id/dpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gap"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padUp"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/act_up"
                    app:icon="@drawable/ic_caret_up"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padLeft"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/act_left"
                    app:icon="@drawable/ic_caret_left"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padRight"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/act_right"
                    app:icon="@drawable/ic_caret_right"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padDown"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/act_down"
                    app:icon="@drawable/ic_caret_down"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/abxy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gap"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padY"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:text="Y"
                    android:textSize="22sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padX"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:text="X"
                    android:textSize="22sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padB"
                    style="@style/Key"
                    android:layout_height="match_parent"
                    android:text="B"
                    android:textSize="22sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padA"
                    style="@style/Key.Accent"
                    android:layout_height="match_parent"
                    android:text="A"
                    android:textSize="22sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

            <com.devbangs.beampad.JoystickView
                android:id="@+id/rightStick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gap"
                android:contentDescription="@string/pad_right_stick" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_game_controller" />

        <TextView
            android:id="@+id/setupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/pad_setup_title"
            android:textAppearance="@style/Text.Title" />

        <TextView
            android:id="@+id/setupBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/pad_setup_body"
            android:textAppearance="@style/Text.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setupAction"
            style="@style/Widget.BeamPad.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/pad_setup_action" />
    </LinearLayout>
</FrameLayout>
