<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingBottom="190dp">

        <!-- Not clipping, so the hero glow can spread past its frame. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp">

                <ImageButton
                    android:id="@+id/close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_x"
                    android:tint="?attr/bpText"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/close" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/restore"
                    style="@style/Widget.BeamPad.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/restore_purchases" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:clipChildren="false">

                <View
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pro_hero" />

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pro_icon"
                    android:elevation="8dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_crown_simple_fill"
                        android:tint="@color/bp_on_pro"
                        android:contentDescription="@null" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/pro_title"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:letterSpacing="-0.01"
                android:textColor="?attr/bpText" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/pro_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/bpTextDim" />

            <TextView
                android:id="@+id/highlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pro_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/bp_on_pro"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/featureList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/compareHeader"
                style="@style/SectionHeader"
                android:paddingStart="4dp"
                android:text="@string/compare_title" />

            <LinearLayout
                android:id="@+id/compareTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/plan_free"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/bpTextDim" />

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_pro_badge"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/pro_badge"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:textColor="@color/bp_on_pro" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/plansHeader"
                style="@style/SectionHeader"
                android:paddingStart="4dp"
                android:text="@string/choose_plan" />

            <LinearLayout
                android:id="@+id/planList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/plansStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/plans_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/bpTextDim" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_footer_scrim"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cta"
            style="@style/Widget.BeamPad.ProButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/cta_continue"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/finePrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/bpTextDim" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terms"
                style="@style/Widget.BeamPad.LinkButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/terms_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dot_separator"
                android:textColor="?attr/bpTextFaint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/privacy"
                style="@style/Widget.BeamPad.LinkButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/privacy_title" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
