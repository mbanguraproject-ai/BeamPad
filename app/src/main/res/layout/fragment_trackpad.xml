<?xml version="1.0" encoding="utf-8"?>
<!-- The trackpad and its two buttons are one unit, like a laptop's: the pad
     takes the room, the buttons attach below with a hairline gap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="@dimen/space_sm">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.devbangs.beampad.TrackpadView
            android:id="@+id/pad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pad"
            android:contentDescription="@string/trackpad_title" />

        <!-- Fades in under the finger while connected. A separate view, not a
             background swap: a drawable change cannot animate. -->
        <View
            android:id="@+id/padGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pad_active"
            android:alpha="0"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_hand_tap"
                android:tint="?attr/bpTextFaint"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/hintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/trackpad_hint_short"
                android:textAppearance="@style/Text.Small.Faint" />
        </LinearLayout>

        <TextView
            android:id="@+id/precision"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_sm"
            android:gravity="center"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_tool_chip"
            android:text="@string/precision"
            android:textAppearance="@style/Text.Label"
            android:textSize="13sp"
            android:textColor="@color/chip_text"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/leftClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pad_button_left"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/left_click"
            android:textAppearance="@style/Text.Label.Small" />

        <TextView
            android:id="@+id/rightClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_pad_button_right"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/right_click"
            android:textAppearance="@style/Text.Label.Small" />
    </LinearLayout>
</LinearLayout>
