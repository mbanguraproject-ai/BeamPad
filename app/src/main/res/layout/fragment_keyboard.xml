<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard: the phone's own keyboard does the typing (autocorrect, swipe,
     voice, every language); this screen adds what a phone keyboard lacks:
     navigation keys, modifiers, function keys and TV search. Keys sit at
     the bottom where thumbs are; the middle shows what was sent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/column"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="@dimen/space_sm">

    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/keyboard_hint"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/Text.Body"
                android:textSize="16sp"
                android:textColorHint="?attr/bpTextFaint"
                android:importantForAutofill="no" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/mic"
                    style="@style/Widget.BeamPad.IconButton.Plain"
                    android:src="@drawable/ic_microphone"
                    android:contentDescription="@string/voice_typing" />

                <FrameLayout
                    android:id="@+id/micLock"
                    style="@style/ToolChipLock"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp">

                    <ImageView style="@style/ToolChipLockIcon" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/gap"
            android:background="@drawable/bg_send_round"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/keyboard_send"
            app:icon="@drawable/ic_paper_plane_right"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="?attr/bpOnAccent" />
    </LinearLayout>

    <!-- Tools share the row evenly; the Pro lock is a corner badge. -->
    <LinearLayout
        android:id="@+id/toolsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/chipLive"
            style="@style/ToolChip">

            <LinearLayout style="@style/ToolChipBody">
                <ImageView style="@style/ToolChipIcon" android:src="@drawable/ic_lightning" />
                <TextView style="@style/ToolChipText" android:text="@string/tool_live" />
            </LinearLayout>

            <FrameLayout android:id="@+id/lockLive" style="@style/ToolChipLock">
                <ImageView style="@style/ToolChipLockIcon" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/chipSearch"
            style="@style/ToolChip"
            android:layout_marginStart="@dimen/space_xs">

            <LinearLayout style="@style/ToolChipBody">
                <ImageView style="@style/ToolChipIcon" android:src="@drawable/ic_magnifying_glass" />
                <TextView style="@style/ToolChipText" android:text="@string/tool_search" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/chipPaste"
            style="@style/ToolChip"
            android:layout_marginStart="@dimen/space_xs">

            <LinearLayout style="@style/ToolChipBody">
                <ImageView style="@style/ToolChipIcon" android:src="@drawable/ic_clipboard_text" />
                <TextView style="@style/ToolChipText" android:text="@string/tool_paste" />
            </LinearLayout>

            <FrameLayout android:id="@+id/lockPaste" style="@style/ToolChipLock">
                <ImageView style="@style/ToolChipLockIcon" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/chipKeys"
            style="@style/ToolChip"
            android:layout_marginStart="@dimen/space_xs">

            <LinearLayout style="@style/ToolChipBody">
                <ImageView style="@style/ToolChipIcon" android:src="@drawable/ic_keyboard" />
                <TextView style="@style/ToolChipText" android:text="@string/tool_full" />
            </LinearLayout>

            <FrameLayout android:id="@+id/lockKeys" style="@style/ToolChipLock">
                <ImageView style="@style/ToolChipLockIcon" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- What was sent this session, newest first, tap to send again. Held in
         memory only: typed text is never written to storage. -->
    <FrameLayout
        android:id="@+id/recentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm">

        <LinearLayout
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_keyboard"
                android:tint="?attr/bpTextFaint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/keyboard_empty_hint"
                android:textAppearance="@style/Text.Small.Faint" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/recentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/keyboard_recent"
                    android:textAppearance="@style/Text.Overline" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/modsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modCtrl"
            style="@style/Key.Small"
            android:text="@string/mod_ctrl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modAlt"
            style="@style/Key.Small"
            android:layout_marginStart="@dimen/gap"
            android:text="@string/mod_alt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modShift"
            style="@style/Key.Small"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/mod_shift"
            app:icon="@drawable/ic_arrow_fat_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modMeta"
            style="@style/Key.Small"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/mod_meta"
            app:icon="@drawable/ic_command" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/fkeysScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/fkeys"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Navigation: the inverted T with Esc and Backspace in its corners,
         Tab and Enter down the side, Space and Home along the bottom. -->
    <LinearLayout
        android:id="@+id/navRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/esc"
            style="@style/Key"
            android:textAppearance="@style/Text.Key.Small"
            android:text="@string/act_esc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/up"
            style="@style/Key"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/act_up"
            app:icon="@drawable/ic_caret_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backspace"
            style="@style/Key"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/act_backspace"
            app:icon="@drawable/ic_backspace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab"
            style="@style/Key"
            android:layout_marginStart="@dimen/gap"
            android:textAppearance="@style/Text.Key.Small"
            android:text="@string/act_tab" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/left"
            style="@style/Key"
            android:contentDescription="@string/act_left"
            app:icon="@drawable/ic_caret_left" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/down"
            style="@style/Key"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/act_down"
            app:icon="@drawable/ic_caret_down" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right"
            style="@style/Key"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/act_right"
            app:icon="@drawable/ic_caret_right" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enter"
            style="@style/Key.Accent"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/act_enter"
            app:icon="@drawable/ic_arrow_elbow_down_left" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/space"
            style="@style/Key"
            android:layout_weight="3.24"
            android:textAppearance="@style/Text.Key.Small"
            android:textColor="?attr/bpTextDim"
            android:text="@string/act_space" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home"
            style="@style/Key"
            android:layout_marginStart="@dimen/gap"
            android:contentDescription="@string/key_home"
            app:icon="@drawable/ic_house" />
    </LinearLayout>

    <!-- The full PC keyboard (Pro). Replaces everything above when on:
         shortcuts along the top, F-keys, then every key of a real keyboard.
         Free users see it behind an upgrade card. -->
    <LinearLayout
        android:id="@+id/fullPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fullType"
                style="@style/Key.Small"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="0"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="@string/fullkb_type"
                android:textColor="?attr/bpAccent2"
                android:contentDescription="@string/fullkb_type_desc"
                app:icon="@drawable/ic_text_aa"
                app:iconTint="?attr/bpAccent2"
                app:iconPadding="6dp"
                app:iconGravity="textStart" />

            <HorizontalScrollView
                android:id="@+id/shortcutScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xs"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/shortcutStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_xs">

            <LinearLayout
                android:id="@+id/fullBody"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/fullFkeys"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <com.devbangs.beampad.FullKeyboardView
                    android:id="@+id/fullKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/gap" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fullLock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="false"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_marginEnd="@dimen/space_md"
                    android:background="@drawable/bg_card"
                    android:elevation="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_pro_icon">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_keyboard"
                            android:tint="@color/bp_on_pro"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:text="@string/fullkb_lock_title"
                        android:textAppearance="@style/Text.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/fullkb_lock_body"
                        android:textAppearance="@style/Text.Small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fullUnlock"
                        style="@style/Widget.BeamPad.ProButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/fullkb_lock_unlock"
                        app:icon="@drawable/ic_crown_simple_fill"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fullBack"
                        style="@style/Widget.BeamPad.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/fullkb_lock_back" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
