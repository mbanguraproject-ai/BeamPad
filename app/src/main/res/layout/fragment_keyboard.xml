<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- match_parent, not wrap_content: fillViewport only grows a child that
         asks to fill, and without that the weighted spacers have nothing to
         distribute and the slack collects at the bottom. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <!-- Send lives inside the input row, as in WhatsApp: the action
             belongs to the field, and a full-width button below it wasted a
             row the navigation keys needed. -->
        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="62dp"
                android:background="@drawable/bg_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_chat_text"
                    app:tint="@color/bp_text_dim"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/keyboard_hint"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/bp_text"
                    android:textColorHint="@color/bp_text_dim"
                    android:textSize="15sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_send_round"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/keyboard_send"
                app:icon="@drawable/ic_paper_plane_right"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/bp_text" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home"
                style="@style/IconKey"
                app:icon="@drawable/ic_house" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/IconKey"
                android:layout_marginStart="10dp"
                app:icon="@drawable/ic_arrow_u_up_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu"
                style="@style/IconKey"
                android:layout_marginStart="10dp"
                app:icon="@drawable/ic_list" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="186dp"
                android:background="@drawable/bg_rocker"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.8"
                    android:padding="15dp"
                    android:src="@drawable/ic_speaker_high"
                    app:tint="@color/bp_text"
                    android:contentDescription="@string/vol" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/volUp"
                    style="@style/RockerKey"
                    app:icon="@drawable/ic_plus" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/vol"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/bp_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/volDown"
                    style="@style/RockerKey"
                    app:icon="@drawable/ic_minus" />
            </LinearLayout>

            <com.devbangs.beampad.DpadView
                android:id="@+id/dpad"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="186dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="186dp"
                android:background="@drawable/bg_rocker"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backspace"
                    style="@style/RockerKey"
                    app:icon="@drawable/ic_backspace" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/del"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/bp_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mute"
                    style="@style/RockerKey"
                    app:icon="@drawable/ic_speaker_slash" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rewind"
                style="@style/WideKey"
                app:icon="@drawable/ic_rewind" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playPause"
                style="@style/WideKey"
                android:layout_marginStart="10dp"
                app:icon="@drawable/ic_play_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forward"
                style="@style/WideKey"
                android:layout_marginStart="10dp"
                app:icon="@drawable/ic_fast_forward" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>
