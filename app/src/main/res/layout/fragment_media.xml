<?xml version="1.0" encoding="utf-8"?>
<!-- Media: transport in the middle where the thumb rests, volume as a
     drag slider, and the "where supported" extras below. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_sm">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prev"
                style="@style/Key.Round"
                android:contentDescription="@string/act_prev_track"
                app:icon="@drawable/ic_skip_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playPause"
                style="@style/Key.Round.Accent"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:contentDescription="@string/act_play_pause"
                app:icon="@drawable/ic_play_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/next"
                style="@style/Key.Round"
                android:contentDescription="@string/act_next_track"
                app:icon="@drawable/ic_skip_forward" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rewind"
                style="@style/Key"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/act_seek_back"
                android:textAppearance="@style/Text.Label"
                app:iconPadding="8dp"
                app:icon="@drawable/ic_rewind" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                style="@style/Key"
                android:layout_weight="0"
                android:layout_width="64dp"
                android:layout_marginStart="@dimen/gap"
                android:contentDescription="@string/act_stop"
                app:icon="@drawable/ic_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forward"
                style="@style/Key"
                android:layout_marginStart="@dimen/gap"
                android:maxLines="1"
                android:ellipsize="end"
                android:contentDescription="@string/act_seek_forward"
                android:text="@string/media_forward"
                android:textAppearance="@style/Text.Label"
                app:iconPadding="8dp"
                app:iconGravity="textEnd"
                app:icon="@drawable/ic_fast_forward" />
        </LinearLayout>

        <!-- Volume -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_speaker_high"
                    android:tint="?attr/bpTextDim"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/volume"
                    android:textAppearance="@style/Text.Subtitle"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mute"
                    style="@style/Widget.BeamPad.SmallButton"
                    android:layout_width="wrap_content"
                    android:text="@string/act_mute"
                    app:icon="@drawable/ic_speaker_slash" />
            </LinearLayout>

            <com.devbangs.beampad.StepSliderView
                android:id="@+id/volume"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:contentDescription="@string/volume_slider_description" />
        </LinearLayout>

        <!-- Player extras. Web and desktop players honour these; TVs may not. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtitles"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:text="@string/act_subtitles"
                app:icon="@drawable/ic_subtitles" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fullscreen"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/act_fullscreen"
                app:icon="@drawable/ic_corners_out" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slower"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/speed_slower"
                app:icon="@drawable/ic_minus" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/faster"
                style="@style/Key.Stacked"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/gap"
                android:text="@string/speed_faster"
                app:icon="@drawable/ic_plus" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/media_extras_note"
            android:textAppearance="@style/Text.Small.Faint" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
