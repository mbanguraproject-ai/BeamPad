<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Control surfaces in one segmented track: built-in modes, then the
         user's panels. Only the selected segment shows its name, so six
         modes fit across a phone; panels scroll on. -->
    <HorizontalScrollView
        android:id="@+id/modeScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_sm">

        <LinearLayout
            android:id="@+id/modeChips"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:background="@drawable/bg_segment_track" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/modeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
