<?xml version="1.0" encoding="utf-8"?>
<!-- Home: one of the four large control-mode tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:minHeight="112dp"
    android:orientation="vertical"
    android:padding="@dimen/space_md"
    android:background="@drawable/bg_choice_card"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/icon_tile"
        android:layout_height="@dimen/icon_tile"
        android:background="@drawable/bg_icon_tile_accent">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:tint="?attr/bpAccent2"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textAppearance="@style/Text.Title" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textAppearance="@style/Text.Small" />
</LinearLayout>
