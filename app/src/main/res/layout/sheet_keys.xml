<?xml version="1.0" encoding="utf-8"?>
<!-- Pro keys. Stays open while keys are pressed, so a run of Page Down or
     Tab does not mean reopening it each time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="4dp"
        android:text="@string/keys_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        android:textColor="?attr/bpText" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:text="@string/keys_body"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/bpTextDim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kTab"
            style="@style/TextKey"
            android:text="@string/key_tab" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/kEsc"
            style="@style/TextKey"
            android:layout_marginStart="10dp"
            android:text="@string/key_esc" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/kEnter"
            style="@style/TextKey"
            android:layout_marginStart="10dp"
            android:text="@string/key_enter" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kHome"
            style="@style/TextKey"
            android:text="@string/key_line_start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/kEnd"
            style="@style/TextKey"
            android:layout_marginStart="10dp"
            android:text="@string/key_line_end" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/kDelete"
            style="@style/TextKey"
            android:layout_marginStart="10dp"
            android:text="@string/key_delete" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kPageUp"
            style="@style/TextKey"
            android:text="@string/key_page_up" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/kPageDown"
            style="@style/TextKey"
            android:layout_marginStart="10dp"
            android:text="@string/key_page_down" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/kSelectAll"
            style="@style/TextKey"
            android:layout_marginStart="10dp"
            android:text="@string/key_select_all" />
    </LinearLayout>
</LinearLayout>
