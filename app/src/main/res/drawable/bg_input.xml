    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33101838" />
            <stroke android:width="1dp" android:color="@color/bp_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
