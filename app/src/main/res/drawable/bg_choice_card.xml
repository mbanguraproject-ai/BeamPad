<?xml version="1.0" encoding="utf-8"?>
<!-- A large selectable card: the chosen one takes the accent edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/bpKeyPressed">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bpSurface" />
                    <stroke android:width="1.5dp" android:color="?attr/bpAccent" />
                    <corners android:radius="@dimen/radius_lg" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bpSurface" />
                    <stroke android:width="1dp" android:color="?attr/bpStroke" />
                    <corners android:radius="@dimen/radius_lg" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
