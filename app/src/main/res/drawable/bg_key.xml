<?xml version="1.0" encoding="utf-8"?>
<!-- Keys: a lit face over a darker sliver, so they read as buttons you
     press rather than outlines. Pressed fills with the accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#5046C8"
                android:endColor="#3A31A8" />
            <stroke android:width="1dp" android:color="@color/bp_accent_2" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#080C22" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#1F2756"
                        android:endColor="#161C44" />
                    <stroke android:width="1dp" android:color="#2B3470" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
