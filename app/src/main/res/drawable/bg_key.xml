<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#332F3A80" />
            <stroke android:width="1.5dp" android:color="@color/bp_accent_2" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14121A38" />
            <stroke android:width="1dp" android:color="#1F2C4A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E141C3D" />
            <stroke android:width="1dp" android:color="@color/bp_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
