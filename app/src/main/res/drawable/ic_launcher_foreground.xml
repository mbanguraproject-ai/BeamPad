<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground, 108dp canvas. Rings live in named groups with
     a centre pivot so the animated variant can scale them outward. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="dot"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,44.5 a9.5,9.5 0 1,0 0.01,0 Z" />
    </group>

    <group
        android:name="ringInner"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.2"
            android:fillColor="#00000000"
            android:pathData="M54,36.5 a17.5,17.5 0 1,0 0.01,0 Z" />
    </group>

    <group
        android:name="ringOuter"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.2"
            android:fillColor="#00000000"
            android:pathData="M54,28 a26,26 0 1,0 0.01,0 Z" />
    </group>

</vector>
