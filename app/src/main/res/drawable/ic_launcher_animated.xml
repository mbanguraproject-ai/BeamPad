<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon. Rings scale outward from the dot and fade as they go, so
     the launch reads as the pad transmitting rather than a logo appearing. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground">

    <target android:name="ringInner">
        <aapt:attr name="android:animation" xmlns:aapt="http://schemas.android.com/aapt">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4" android:valueTo="1.0"
                    android:startOffset="80" android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.4" android:valueTo="1.0"
                    android:startOffset="80" android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ringOuter">
        <aapt:attr name="android:animation" xmlns:aapt="http://schemas.android.com/aapt">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4" android:valueTo="1.0"
                    android:startOffset="240" android:duration="460"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.4" android:valueTo="1.0"
                    android:startOffset="240" android:duration="460"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
