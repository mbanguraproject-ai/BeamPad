<?xml version="1.0" encoding="utf-8"?>
<!-- Pill key: the gamepad's small buttons between the sticks, as on a controller. States as bg_key. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/bpKeyPressed" /><stroke android:width="1dp" android:color="?attr/bpStrokeStrong" /><corners android:radius="100dp" /></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="?attr/bpAccentSoft" /><stroke android:width="1dp" android:color="?attr/bpAccent" /><corners android:radius="100dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/bpKey" /><stroke android:width="1dp" android:color="?attr/bpKeyStroke" /><corners android:radius="100dp" /></shape></item>
</selector>
