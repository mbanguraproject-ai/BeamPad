<?xml version="1.0" encoding="utf-8"?>
<!-- The left bumper: a shoulder, rounded wide at its outer top corner. States as bg_key. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/bpKeyPressed" /><stroke android:width="1dp" android:color="?attr/bpStrokeStrong" /><corners android:topLeftRadius="28dp" android:topRightRadius="@dimen/radius_sm" android:bottomLeftRadius="@dimen/radius_sm" android:bottomRightRadius="@dimen/radius_sm" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/bpKey" /><stroke android:width="1dp" android:color="?attr/bpKeyStroke" /><corners android:topLeftRadius="28dp" android:topRightRadius="@dimen/radius_sm" android:bottomLeftRadius="@dimen/radius_sm" android:bottomRightRadius="@dimen/radius_sm" /></shape></item>
</selector>
