<?xml version="1.0" encoding="utf-8"?>
<!-- Left and right click strip under the trackpad. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#334F46E5" />
            <stroke android:width="1dp" android:color="@color/bp_accent_2" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bp_surface" />
            <stroke android:width="1dp" android:color="@color/bp_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
