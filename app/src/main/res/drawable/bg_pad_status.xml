<?xml version="1.0" encoding="utf-8"?>
<!-- The gamepad's status pill: quieter than a key, lit while pressed when it has an action. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/bpKeyPressed" /><stroke android:width="1dp" android:color="?attr/bpStrokeStrong" /><corners android:radius="100dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="?attr/bpSurface" /><stroke android:width="1dp" android:color="?attr/bpStroke" /><corners android:radius="100dp" /></shape></item>
</selector>
