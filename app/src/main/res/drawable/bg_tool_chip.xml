<?xml version="1.0" encoding="utf-8"?>
<!-- Tool chips under the text field. Selected is used for the live
     typing toggle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26FFFFFF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#334F46E5" />
                    <stroke android:width="1.5dp" android:color="@color/bp_accent_2" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bp_surface" />
                    <stroke android:width="1dp" android:color="@color/bp_stroke" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
