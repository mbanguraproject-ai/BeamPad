<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/bpAccentSoft">
    <item>
            <selector>
                <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bpAccentSoft" />
                    <stroke android:width="1.5dp" android:color="?attr/bpAccent" />
                    <corners android:radius="999dp" />
                </shape>
                </item>
                <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bpSurface" />
                    <stroke android:width="1dp" android:color="?attr/bpStroke" />
                    <corners android:radius="999dp" />
                </shape>
                </item>
            </selector>
    </item>
</ripple>
