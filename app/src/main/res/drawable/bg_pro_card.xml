<?xml version="1.0" encoding="utf-8"?>
<!-- Settings upsell card: warm edge on the usual surface. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#33FF8A4C"
                android:endColor="#1A4F46E5" />
            <stroke android:width="1dp" android:color="#80FF8A4C" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
