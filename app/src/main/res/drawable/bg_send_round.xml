<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="@color/bp_surface" />
                    <stroke android:width="1dp" android:color="@color/bp_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="@color/bp_accent"
                        android:endColor="@color/bp_accent_2" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
